# Build environment for the small model's program (dictate-tinyasr), used by install.sh only when this
# computer has no Rust (cargo). Only signed Fedora packages, nothing else. The image holds the compiler;
# install.sh then builds engine/worker in it with no network (--network none) and copies the static
# binary out. glibc-static is what makes the binary static (no libraries needed on your system).
# Base: the same pinned Fedora as helper/Containerfile (by digest, so it cannot change under you).
FROM registry.fedoraproject.org/fedora-minimal:44@sha256:bab880dd1b156a65b611b1d5f69ebdbf92382f78d26ee3bf1eb47648b2fa46fa
RUN dnf -y install --setopt=install_weak_deps=False --nodocs cargo rust glibc-static && dnf clean all
