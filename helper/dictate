def model_command(cmd, variant):
    try:
        if variant == "small" or variant.startswith("small:"):
            pack = variant[6:]
            if pack not in TINY_PACKS and (pack or cmd == "--remove"):
                raise Fail(f"Unknown language pack {pack!r} ({', '.join(TINY_PACKS)})")
            if cmd == "--remove":
                remove_small(pack)
            else:
                download_small([pack] if pack else download_packs(speech()["languages"]))
        elif variant not in VARIANTS:
            raise Fail(f"Unknown model variant {variant!r} (small, small:PACK, int8 or fp32)")
        else:
            (download if cmd == "--download" else remove)(variant)
    except Fail as e:
        print(f"Error: {e}" if sys.stdout.isatty() else f"E {e}", flush=True)
        sys.exit(1)


def main(trial=False):
    """One dictation. trial (dictate --try, the settings window's test): nothing is kept, neither the
    recording nor its text."""
    cleanup_old()
    path = None
    rec = Recognizer()
    streamer = None
    try:
        try:
            rec.start()                                   # loads while you speak
        except Fail as e:
            if isinstance(e, Unusable):                   # nothing to transcribe with: do not record
                out(f"E {e}")
                return
            log(f"model start: {e}")                      # record anyway; the recording is kept
        streamer = Streamer(rec)                          # transcribes pieces while you speak
        raw = record(streamer)
        if raw is None:
            return
        seconds = len(raw) / 2 / RATE
        if seconds < MIN_SECONDS:
            raise Fail("Too short")
        wav = to_wav(raw)
        del raw
        path = None if trial else keep(wav)
        out("S")
        text = transcribe(wav, seconds, rec=rec, streamer=streamer)
        rec.close()
        if not text:
            if path:
                os.unlink(path)
            path = None
            raise Fail("No speech recognised")
        out("T " + json.dumps(text, ensure_ascii=False))
        if path:
            try:
                if privacy()["history"]:
                    remember(path, text, seconds)
            except OSError as e:
                log(f"history: {e}")
            discard(path)                                 # the audio is never kept after its text
        path = None
    except Fail as e:
        if path and str(e) == "No speech recognised":      # silence: nothing worth keeping
            os.unlink(path)
            path = None
        out(f"E {e}" + (", recording kept, menu: Retry" if path else ""))
    except Exception as e:                                # never leave the overlay hanging
        log(f"crash: {type(e).__name__}: {e}")
        out(f"E {type(e).__name__}" + (", recording kept, menu: Retry" if path else ""))
    finally:
        if streamer:
            streamer.stop()
        rec.close(done=True)


def retry():
    """Transcribe the kept (failed) recordings again. Prints S, then one T line per text (or E), like a
    recording: the extension shows them in the microphone menu. Never touches the clipboard."""
    cleanup_old()
    try:
        files = sorted(f for f in os.listdir(PENDING_DIR) if f.endswith(".wav"))
    except OSError:
        files = []
    if not files:
        out("E No saved recordings")
        return
    out("S")
    history = privacy()["history"]
    rec = Recognizer()
    try:
        for name in files:
            p = os.path.join(PENDING_DIR, name)
            with open(p, "rb") as f:
                wav = f.read()
            seconds = (len(wav) - 44) / 2 / RATE
            try:
                text = transcribe(wav, seconds, rec=rec)
            except Fail as e:          # keep this one and the rest
                out(f"E Still failing: {e}")
                return
            if text:
                out("T " + json.dumps(text, ensure_ascii=False))
                if history:
                    try:
                        remember(p, text, seconds)
                    except OSError as e:
                        log(f"history: {e}")
            discard(p)
    finally:
        rec.close()


def redo(stamp, lang=None):
    """`dictate --redo`: transcribe a history recording again, as `lang` (only that language's letters,
    plus plain Latin) or with the saved languages. The new text replaces the old one in the history."""
    cleanup_old()
    try:
        if not re.fullmatch(r"rec-\d{8}-\d{6}", stamp) or lang not in (None, *LANGS):
            raise Fail("Bad request")
        if lang and lang not in LARGE_LANGS and model_variant() not in (None, "small"):
            raise Fail(f"Bad request: the Large model does not know {lang}")
        try:
            with open(os.path.join(HISTORY_DIR, stamp + ".wav"), "rb") as f:
                wav = f.read()
            with open(os.path.join(HISTORY_DIR, stamp + ".json")) as f:
                meta = json.load(f)
        except (OSError, ValueError):
            raise Fail("That recording is gone") from None
        if not isinstance(meta, dict):
            raise Fail("That recording is gone")
        out("S")
        settings = speech()
        if lang:
            settings["languages"] = [lang]
        text = transcribe(wav, (len(wav) - 44) / 2 / RATE, settings=settings)
        if not text:
            raise Fail("No speech recognised")
        save_meta(stamp, {**meta, "text": text})
        out("T " + json.dumps(text, ensure_ascii=False))
    except Fail as e:
        out(f"E {e}")
    except Exception as e:                                # never leave the overlay hanging
        log(f"redo crash: {type(e).__name__}: {e}")
        out(f"E {type(e).__name__}")


def selftest():
    """Starts the model in use (and the Small model too, if it is installed) and transcribes 1 s of
    silence: checks the runtime and the model files, and that the model's sandbox has no network."""
    used = model_variant()
    for variant in [used] + (["small"] if used not in (None, "small") and installed("small") else []):
        t0 = time.monotonic()
        rec = Recognizer(variant)
        try:
            res = rec.request(b"\0\0" * RATE, speech())
            print(f"OK: the speech model works ({rec.variant} via {rec.via}, load {rec.ready}s, "
                  f"asr {res.get('asr_s')}s, {time.monotonic() - t0:.1f}s in all)")
            if variant == "small":                    # the worker's own check, in the worker's sandbox
                prefix, worker, _ = tiny_sandbox()
                cmd = prefix + [worker, "--netcheck"]
            else:
                prefix = sandbox(rec.via)[0]
                cmd = prefix + ["-c", NETCHECK]
            try:
                net = subprocess.run(cmd, capture_output=True, text=True, timeout=60).stdout.strip()
            except (OSError, subprocess.SubprocessError):
                net = "?"
            if net != "blocked":
                raise Fail(f"the speech model's sandbox does not block the network (got {net!r})")
            print(f"OK: no network for the speech model ({prefix[0]} sandbox)")
        except Fail as e:
            print(f"FAILED: {e}. Details: ~/.cache/dictate/dictate.log")
            sys.exit(1)
        finally:
            rec.close()


