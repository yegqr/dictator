def speech():
    p = {"languages": ["uk", "en", "ru"], "margin": 0.15, "threads": 0, "final_period": "keep",
         "microphone": "default", "auto_stop": 0, "voice_gate": "off", "spoken_punctuation": False,
         "fillers": True, "model": "small"}
    try:
        with open(SPEECH_FILE) as f:
            for line in f:
                m = re.fullmatch(r"\s*(languages|margin|threads|final_period|microphone|auto_stop|voice_gate"
                                 r"|spoken_punctuation|fillers|model)"
                                 r"\s*=\s*(.*?)\s*", line)
                if not m:
                    continue
                k, v = m[1], m[2]
                try:
                    if k == "languages":
                        langs = [c for c in dict.fromkeys(v.replace(",", " ").split()) if c in LANGS]
                        p[k] = langs or p[k]
                    elif k == "margin":
                        p[k] = min(2.0, max(0.0, float(v)))
                    elif k == "threads":
                        p[k] = min(64, max(0, int(v)))
                    elif k == "auto_stop":
                        p[k] = min(60, max(0, int(v)))
                    elif k == "microphone":
                        p[k] = v if re.fullmatch(r"[\w.:@+-]+", v) else "default"
                    elif k == "voice_gate":
                        p[k] = v if v in GATE_DB else "off"
                    elif k in ("spoken_punctuation", "fillers"):
                        p[k] = v == "on"
                    elif k == "model":
                        p[k] = v if v in MODELS else "small"
                    elif v in ("keep", "drop", "chats"):
                        p[k] = v
                except ValueError:
                    pass
    except OSError:
        pass
    return p


def replacements():
    """[(compiled pattern, replacement)] from ~/.config/dictate/replacements; whole words, any case"""
    out_ = []
    try:
        with open(REPLACE_FILE, encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                a, b = (x.strip() for x in line.split("=", 1))
                if a:
                    out_.append((re.compile(r"(?<!\w)" + re.escape(a) + r"(?!\w)", re.I), b))
    except OSError:
        pass
    return out_


# A line break the user asked for ("новий рядок"): a private-use character, not "\n", so that every
# cleaning step keeps it; the extension turns it into a line break, or into a space in a terminal (a
# line break there would run a command).
NEWLINE_MARK = "\ue000"
# spoken punctuation, per language: phrase -> what it becomes (longer phrases first)
SPOKEN = {
    "uk": [("крапка з комою", ";"), ("знак питання", "?"), ("знак оклику", "!"), ("двокрапка", ":"),
           ("новий абзац", "\n\n"), ("новий рядок", "\n"), ("кома", ","), ("крапка", "."), ("тире", "—")],
    "ru": [("точка с запятой", ";"), ("вопросительный знак", "?"), ("знак вопроса", "?"),
           ("восклицательный знак", "!"), ("двоеточие", ":"), ("новый абзац", "\n\n"),
           ("новая строка", "\n"), ("запятая", ","), ("точка", "."), ("тире", "—")],
    "en": [("question mark", "?"), ("exclamation mark", "!"), ("exclamation point", "!"),
           ("semicolon", ";"), ("colon", ":"), ("new paragraph", "\n\n"), ("new line", "\n"),
           ("comma", ","), ("full stop", "."), ("period", "."), ("dash", "—")],
}
# hesitation sounds only (not words like "ну" / "well", which can carry meaning)
FILLERS = re.compile(r"(?<!\w)(?:е{2,}м*|э{2,}м*|а{2,}|м{2,}|ем{1,}|эм{1,}|хм+|u+h+m*|u+m+|e+r+m+|h+m+|m{2,})(?!\w)"
                     r"[,.]?", re.I)
PUNCT = "[\\s,.;:!?]*"
# where a command word is an ordinary word: "точка зрения", "the period of"
NOT_COMMAND = {"точка": r"(?!\s+(?:зрения|отсч[её]та|опоры|доступа|росы|кипения|замерзания|соприкосновения))",
               "крапка": r"(?!\s+(?:зору|відліку|опори|доступу))", "period": r"(?!\s+of\b)",
               "colon": r"(?!\s+(?:cancer|health)\b)", "dash": r"(?!\s+(?:cam|board)\b)"}


def spoken_punctuation(text, langs):
    for lang in langs:
        for phrase, sym in SPOKEN.get(lang, []):
            words = r"\s+".join(map(re.escape, phrase.split()))
            # a line break keeps the punctuation before it ("справи? новий рядок"), the rest replace it
            lead = r"[\s,]*" if sym.startswith("\n") else PUNCT
            pat = re.compile(lead + r"(?<!\w)" + words + r"(?!\w)" + NOT_COMMAND.get(phrase, "") + PUNCT, re.I)
            if sym.startswith("\n"):
                rep_ = NEWLINE_MARK * len(sym)
            elif sym == "—":
                rep_ = " — "
            else:
                rep_ = sym + " "
            text = pat.sub(lambda m: rep_, text)
    # a capital letter after the end of a sentence or a line break
    text = re.sub(r"([.?!]\s+|" + NEWLINE_MARK + r")(\w)", lambda m: m[1] + m[2].upper(), text)
    return text.strip(" ")


def polish(text, settings=None):
    """The user's text settings: hesitation sounds out, spoken punctuation, word replacements and
    snippets, no final period"""
    settings = settings or speech()
    text = text.replace(NEWLINE_MARK, " ")        # only a spoken command may make a line break
    if settings["fillers"]:
        at_start = bool(FILLERS.match(text.lstrip()))
        text = FILLERS.sub("", text)
        text = re.sub(r"\s+([,.;:!?])", r"\1", " ".join(text.split()))
        text = re.sub(r"^[,.;:]\s*", "", text)
        if at_start:                       # "Еее, привіт" -> "Привіт"
            text = text[:1].upper() + text[1:]
    if settings["spoken_punctuation"]:
        text = spoken_punctuation(text, settings["languages"])
    for pat, rep_ in replacements():
        text = pat.sub(lambda m: rep_, text)
    if settings["final_period"] == "drop" and text.endswith(".") and not text.endswith(".."):
        text = text[:-1]
    # spaces around a line break are not wanted
    text = re.sub(r" *(" + NEWLINE_MARK + r"+) *", r"\1", text)
    return clean(text)


# Speech gives one line of words. Control characters (line breaks, ESC sequences), zero-width and
# bidi-override characters cannot come from it: they are cut, so that even a tampered model cannot
# make the paste run a command in a terminal or hide text (the extension cleans the text again).
_BAD_CHARS = re.compile("[\x00-\x1f\x7f-\x9f\u200b-\u200f\u2028\u2029\u202a-\u202e\u2066-\u2069\ufeff]")


def clean(text):
    if not isinstance(text, str):
        return ""
    return " ".join(_BAD_CHARS.sub(" ", text).split())[:MAX_TEXT]


def out(line):
    sys.stdout.write(line + "\n")
