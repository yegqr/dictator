def locked(folder=MODEL_DIR):
    """True while another `dictate --download` runs (into folder: MODEL_DIR Large, TINY_DIR Small)."""
    import fcntl
    try:
        with open(os.path.join(folder, ".lock"), "a") as f:
            fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return False
    except BlockingIOError:
        return True
    except OSError:
        return False


class Progress:
    """Progress lines for the settings window ("P <stage> <done> <total>"), or a bar in a terminal."""

    def __init__(self, stage, total):
        self.stage, self.total, self.done, self.last = stage, total, 0, 0.0
        self.tty = sys.stdout.isatty()

    def add(self, n):
        self.done += n
        now = time.monotonic()
        if now - self.last >= 0.25 or self.done >= self.total:
            self.last = now
            if self.tty:
                pct = 100 * self.done / max(self.total, 1)
                sys.stdout.write(f"\r{self.stage}: {self.done / 1e9:.2f} of {self.total / 1e9:.2f} GB "
                                 f"({pct:.0f}%)" + ("\n" if self.done >= self.total else ""))
                sys.stdout.flush()
            else:
                out(f"P {self.stage} {self.done} {self.total}")


def sha256_of(path, progress=None):
    import hashlib
    h = hashlib.sha256()
    with open(path, "rb") as f:
        while block := f.read(1 << 20):
            h.update(block)
            if progress:
                progress.add(len(block))
    return h.hexdigest()


def fetch(name, dest_dir, progress, source=None):
    """Download one model file into dest_dir (resuming a partial download) and check its SHA-256.
    source: (url, bytes, sha256); without it the Large model's file `name`."""
    import urllib.error
    import urllib.request
    url, size, digest = source or (MODEL_URL + name, *MODEL_FILES[name])
    path = os.path.join(dest_dir, name)
    if os.path.isfile(path) and os.path.getsize(path) == size and sha256_of(path) == digest:
        progress.add(size)
        return path
    part = path + ".part"
    have = os.path.getsize(part) if os.path.isfile(part) else 0
    if have > size:
        os.unlink(part)
        have = 0
    progress.add(have)
    if have < size:
        req = urllib.request.Request(url, headers={"User-Agent": "dictator-model-download"})
        if have:
            req.add_header("Range", f"bytes={have}-")
        try:
            with urllib.request.urlopen(req, timeout=30) as r:
                if have and r.status != 206:                # the server sends it all again
                    progress.add(-have)
                    have = 0
                with open(part, "ab" if have else "wb") as f:
                    while block := r.read(1 << 20):
                        have += len(block)
                        if have > size:                 # more than the file has: never fill the disk
                            f.close()
                            discard(part)               # junk: the next try starts clean
                            raise Fail(f"{name}: the server sends more than the expected file. Try again later")
                        f.write(block)
                        progress.add(len(block))
        except (urllib.error.URLError, OSError) as e:
            raise Fail(f"Download failed ({getattr(e, 'reason', e)}). Try again: it continues "
                       "where it stopped") from None
    if sha256_of(part) != digest:
        os.unlink(part)
        raise Fail(f"{name}: the downloaded file is not the expected one (SHA-256 differs). Deleted it")
    os.replace(part, path)
    return path


def download_lock(folder):
    """Creates folder and locks its .lock for this download (Fail if another one is running); a SIGTERM
    (cancelled) ends the program, so the finally blocks clean up. Keep the returned file while downloading."""
    import fcntl
    os.makedirs(folder, exist_ok=True)
    lock = open(os.path.join(folder, ".lock"), "a")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        lock.close()
        raise Fail("A download is already running") from None
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(1))
    return lock


def finished(msg):
    """The end of a download: msg in a terminal, else "D" (for the settings window)."""
    if sys.stdout.isatty():
        print(msg)
    else:
        out("D")


def download(variant):
    """Install a model variant. fp32: download it. int8: download the fp32 files into a work folder,
    convert them on this computer (in the sandbox, no network), keep the int8 files, delete the rest."""
    lock = download_lock(MODEL_DIR)            # held while this runs
    work = os.path.join(MODEL_DIR, ".work")
    fp32 = sum(MODEL_FILES[n][0] for n in FP32_FILES)
    need = sum(MODEL_FILES[n][0] for n in COMMON_FILES) + fp32 + (INT8_SIZE if variant == "int8" else 0)
    if shutil.disk_usage(MODEL_DIR).free < need - partial_bytes(work) + 200_000_000:
        raise Fail(f"Not enough free disk space: {need / 1e9:.1f} GB needed in {MODEL_DIR}")
    if variant == "int8":
        if free_memory_gb() < QUANTIZE_MEMORY_GB:
            raise Fail(f"Not enough free memory to convert the model: {QUANTIZE_MEMORY_GB} GB needed. "
                       "Close some apps and try again")
        check_runtime(convert=True)
    log(f"model download: {variant}")
    progress = Progress("download", need - (INT8_SIZE if variant == "int8" else 0))
    for name in COMMON_FILES:
        fetch(name, MODEL_DIR, progress)
    if variant == "fp32":
        for name in FP32_FILES:
            fetch(name, MODEL_DIR, progress)
    else:
        os.makedirs(work, exist_ok=True)
        for name in FP32_FILES:
            have = os.path.join(MODEL_DIR, name)        # fp32 installed already: no second download
            if installed("fp32") and not os.path.exists(os.path.join(work, name)):
                os.link(have, os.path.join(work, name))
            fetch(name, work, progress)
        quantize(work)
        same = True
        for name in INT8_FILES:
            same &= sha256_of(os.path.join(work, name)) == INT8_REFERENCE[name]
            os.replace(os.path.join(work, name), os.path.join(MODEL_DIR, name))
        shutil.rmtree(work)
        log(f"model int8 {'identical to' if same else 'differs slightly from'} the reference build")
    write_notice()
    log(f"model {variant} installed")
    finished("The speech model is installed.")


def partial_bytes(work):
    try:
        return sum(os.path.getsize(os.path.join(work, n)) for n in os.listdir(work))
    except OSError:
        return 0


def free_memory_gb():
    try:
        with open("/proc/meminfo") as f:
            info = dict(line.split(":", 1) for line in f)
        return int(info["MemAvailable"].split()[0]) / 1024 / 1024
    except (OSError, KeyError, ValueError):
        return QUANTIZE_MEMORY_GB


def check_runtime(convert=False):
    """Fail early, with the fix, when the model's runtime cannot run (or cannot convert)."""
    via = runtime()
    if via == "host":
        import importlib.util
        mods = ["onnxruntime", "numpy"] + (["onnx"] if convert else [])
        missing = [m for m in mods if not importlib.util.find_spec(m)]
        if missing:
            raise Fail("System Python lacks " + ", ".join(f"python3-{m}" for m in missing) +
                       ": install it with your package manager")
    elif not shutil.which(via) or subprocess.run([via, "image", "inspect", ASR_IMAGE],
                                                 capture_output=True).returncode:
        raise Fail(f"The {via} image {ASR_IMAGE} is missing: run install.sh again")
    elif convert and subprocess.run(sandbox(via)[0] + ["-c", "import onnx"], capture_output=True).returncode:
        raise Fail(f"The {via} image {ASR_IMAGE} is from an older Dictator: run install.sh again")


def quantize(work):
    """parakeet.py --quantize in the sandbox (no network), with the work folder writable."""
    try:
        with open(ASR_SCRIPT) as f:
            code = f.read()
    except OSError:
        raise Fail("Speech model program missing") from None
    if sys.stdout.isatty():
        print("Converting to int8 on this computer (about a minute)...")
    else:
        out("P convert 0 1")
    prefix, folder = sandbox(runtime(), work, writable=True)
    proc = subprocess.Popen(prefix + ["-c", code, "--quantize", folder], stdout=subprocess.PIPE,
                            stderr=subprocess.DEVNULL, text=True)
    try:
        res, _ = proc.communicate(timeout=1800)
    finally:
        if proc.poll() is None:
            proc.terminate()
            proc.wait()
    try:
        res = json.loads(res.strip().splitlines()[-1])
    except (ValueError, IndexError):
        res = {"error": f"exit code {proc.returncode}" + (" (out of memory?)" if proc.returncode in (-9, 137)
                                                          else "")}
    if "error" in res:
        log(f"quantize failed: {res['error']}")
        raise Fail(f"Converting the model failed: {res['error']}")
    if not sys.stdout.isatty():
        out("P convert 1 1")


