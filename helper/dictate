def download_small(packs):
    """Install Small model language packs (the voice detector comes with the first one): download each
    .gz into a work folder (resuming a partial download) and check its SHA-256, unpack it with a hard size
    limit and check the unpacked file's SHA-256, and only then move the files in place. Anything wrong:
    nothing new is installed."""
    lock = download_lock(TINY_DIR)             # held while this runs
    work = os.path.join(TINY_DIR, ".work")
    files = [tiny_file(p) for p in packs if not tiny_ok(tiny_file(p))]
    if files and not tiny_ok(TINY_VAD):
        files.append(TINY_VAD)                  # last: a bad pack fails before it is fetched
    need = sum(e[1] + e[3] for e in files)
    if shutil.disk_usage(TINY_DIR).free < need - partial_bytes(work) + 50_000_000:
        raise Fail(f"Not enough free disk space: {need / 1e6:.0f} MB needed in {TINY_DIR}")
    log(f"model download: small {','.join(packs)}")
    progress = Progress("download", sum(e[1] for e in files))
    try:
        os.makedirs(work, exist_ok=True)
        for e in files:
            fetch(e[0] + ".gz", work, progress, (TINY_URL + e[0] + ".gz", e[1], e[2]))
        for e in files:
            gunzip(os.path.join(work, e[0] + ".gz"), os.path.join(work, e[0]), e[3], e[4])
        for e in reversed(files):               # the voice detector first: a pack is never there without it
            os.replace(os.path.join(work, e[0]), os.path.join(TINY_DIR, e[0]))
        shutil.rmtree(work)
    finally:
        for e in files:                         # unpacked but not installed
            discard(os.path.join(work, e[0]))
    write_small_notice()
    log(f"model small {','.join(packs)} installed")
    finished("The language pack is installed." if len(packs) == 1 else "The language packs are installed.")


def gunzip(src, dest, size, digest):
    """Unpack src into dest, stopping beyond `size` bytes (a .gz can unpack to far more than it holds),
    and check the result's SHA-256. Anything wrong: both files are deleted."""
    import gzip
    import hashlib
    import zlib
    h, n, name = hashlib.sha256(), 0, os.path.basename(dest)
    try:
        with gzip.open(src, "rb") as f, open(dest, "wb") as o:
            while block := f.read(1 << 20):
                n += len(block)
                if n > size:
                    raise Fail(f"{name}: unpacks to more than the expected {size} bytes. Deleted it")
                h.update(block)
                o.write(block)
        if n != size or h.hexdigest() != digest:
            raise Fail(f"{name}: the unpacked file is not the expected one (SHA-256 differs). Deleted it")
    except (OSError, EOFError, zlib.error) as e:
        discard(dest)
        discard(src)
        raise Fail(f"{name}: unpacking failed ({type(e).__name__}). Deleted it") from None
    except Fail:
        discard(dest)
        discard(src)
        raise


