def privacy():
    p = {"history": True, "keep_minutes": 60, "keep_audio": False}
    try:
        with open(PRIVACY_FILE) as f:
            for line in f:
                m = re.fullmatch(r"\s*(history|keep_minutes|keep_audio)\s*=\s*(\S+)\s*", line)
                if m and m[1] == "history":
                    p["history"] = m[2] != "off"
                elif m and m[1] == "keep_audio":
                    p["keep_audio"] = m[2] == "on"
                elif m and m[2].isdigit():
                    p["keep_minutes"] = int(m[2])
    except OSError:
        pass
    return p


