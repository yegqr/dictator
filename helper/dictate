def pack_for(lang, packs):
    """the first of packs that has lang, or None"""
    return next((p for p in packs if lang in TINY_PACKS[p][0]), None)


def small_plan(languages):
    """For the Small model: (the enabled languages the installed packs have, main first; the packs to
    load, the main language's first). None of them: an error that names the pack to download."""
    have = small_packs()
    langs = [c for c in languages if pack_for(c, have)]
    if not langs:
        want = next(iter(pick_packs(languages, TINY_PACKS)), None)
        if want:
            raise Unusable(f"The Small model has no language pack for {' '.join(languages)}: download {want} "
                           "(Settings, page Speech)")
        raise Unusable(f"The Small model does not know {' '.join(languages)}: choose other languages "
                       "or the Large model (Settings, page Speech)")
    return langs, pick_packs(langs, have)


def pick_packs(languages, packs):
    """The packs for these languages, main first (the same rule as install.sh): each language but en takes
    the first of packs (in TINY_PACKS order) that has it; en adds the first one with en only if nothing
    else was picked (en then comes from the first picked pack that has it)."""
    out = []
    for c in languages:
        p = pack_for(c, packs) if c != "en" else None
        if p and p not in out:
            out.append(p)
    if not out and "en" in languages and pack_for("en", packs):
        out.append(pack_for("en", packs))
    return out


def download_packs(languages):
    """the packs `dictate --download small` gets for the enabled languages (en-ru-uk if none has one)"""
    return pick_packs(languages, TINY_PACKS) or ["en-ru-uk"]


